# Copy to `.env.local` (gitignored) and fill in real values.
#
# Product Implementation Constitution Ch.10 §3 — these are the marketing
# site's complete set of environment variables; the typed schema that reads
# them is `src/shared/env.ts`, and nothing should read `process.env` directly
# anywhere else. Names follow Ch.9 §6: <APP_PREFIX>_<SCREAMING_SNAKE_NAME>.
#
# All three are optional. With none of them set the contact form still
# validates submissions and reports success, logging server-side that nothing
# was delivered — so the app builds, tests, and runs without any secret.

# Resend API key. https://resend.com/api-keys
MARKETING_SITE_RESEND_API_KEY=

# Destination address for validated contact-form submissions.
# Production value: hello@tradyperch.com
MARKETING_SITE_CONTACT_INBOX_EMAIL=

# Envelope sender. Resend rejects any `from` whose domain is not verified in
# the account. Leaving this unset falls back to the built-in default
# ("Trady Perch site <onboarding@resend.dev>") — Resend's shared test sender,
# which needs no domain verification but can only deliver to the Resend
# account owner's own address.
#
# THESE TWO VARIABLES ARE A MATCHED PAIR. The test sender's recipient
# restriction means an inbox that is NOT the account owner's own address
# requires a verified sending domain here. Set one without the other and every
# submission fails with a 403 the route surfaces as a 502 — the visitor sees an
# error and their message is lost. In particular, do not leave this blank while
# the inbox is hello@tradyperch.com; the default sender would reject it.
#
# tradyperch.com is verified in Resend (since 2026-07-31), so production sets
# this to "Trady Perch site <hello@tradyperch.com>".
#
# Sending and receiving are independent. Resend verification grants the right
# to SEND from the domain; hello@ RECEIVES because tradyperch.com's MX records
# point at Hostinger mail.
MARKETING_SITE_RESEND_FROM_EMAIL=
